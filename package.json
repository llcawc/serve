{
  "name": "@pasmurno/serve",
  "version": "0.0.6",
  "description": "Vite based static server for local development",
  "homepage": "https://github.com/llcawc/serve",
  "license": "MIT",
  "author": "llcawc",
  "bin": {
    "serve": "bin/serve.js"
  },
  "files": [
    "bin",
    "server",
    "package.json",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./server/server.cjs",
  "module": "./server/server.js",
  "types": "./server/server.d.cts",
  "exports": {
    ".": {
      "import": "./server/server.js",
      "require": "./server/server.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest --run",
    "lint": "oxlint",
    "fix": "oxlint --fix",
    "check": "oxfmt --check",
    "fmt": "oxfmt",
    "validate": "oxlint && tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "serve": "node bin/serve --host -p 8080",
    "tsc": "tsc source/comm.ts --ignoreConfig --outDir server",
    "build": "pnpm tsc && tsdown -d ./server --no-clean"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "vite": "^8.0.3"
  },
  "devDependencies": {
    "@types/gulp": "^4.0.18",
    "@types/node": "^25.5.2",
    "@typescript/native-preview": "7.0.0-dev.20260403.1",
    "gulp": "^5.0.1",
    "oxfmt": "^0.43.0",
    "oxlint": "^1.58.0",
    "sass": "^1.99.0",
    "tsdown": "^0.21.7",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
